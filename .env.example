COMPOSE_PROJECT_NAME=crapi-llm

# crAPI image tag
VERSION=develop

# Local bind address for crAPI ports
LISTEN_IP=127.0.0.1

# Disable TLS for local lab
TLS_ENABLED=false

# crAPI service ports
IDENTITY_SERVER_PORT=8080
COMMUNITY_SERVER_PORT=8087
WORKSHOP_SERVER_PORT=8000
CHATBOT_SERVER_PORT=5002

# crAPI chatbot LLM config
CHATBOT_LIFE=1
CHATBOT_LLM_PROVIDER=openai
CHATBOT_LLM_MODEL=llama3.1:8b
CHATBOT_EMBEDDINGS_MODEL=nomic-embed-text:latest
CHATBOT_EMBEDDINGS_DIMENSIONS=768
CHATBOT_OPENAI_API_KEY=ollama

# Ollama URL - set this to wherever Ollama is reachable from the crAPI container.
# Examples:
#   Remote GPU box:           OLLAMA_HOST_IP=192.168.1.50
#   Local Docker Desktop:     OLLAMA_HOST_IP=host.docker.internal
#   Linux Docker Engine host:   OLLAMA_HOST_IP=192.168.1.42  (or 172.17.0.1)
#   Same machine, no Docker:    OLLAMA_HOST_IP=127.0.0.1 (not from inside a container)
OLLAMA_HOST_IP=YOUR_OLLAMA_HOST_IP
CHATBOT_OPENAI_BASE_URL=http://${OLLAMA_HOST_IP}:11434/v1/

# Optional: the standalone Python agent reads this when run from the host shell.
OLLAMA_BASE_URL=http://${OLLAMA_HOST_IP}:11434/v1
